# Copie para backend/.env
DATABASE_URL="postgresql://pf:pf@localhost:5433/app_starter?schema=public"

PORT=3333
JWT_SECRET=change-me-in-development
JWT_EXPIRES_DAYS=7
# Vite pode usar 5174 se 5173 estiver ocupada — inclua ambas (ou deixe o default no código)
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# Opcional: armazenamento local de mídia (uploads)
# UPLOAD_ROOT=/caminho/absoluto/uploads
